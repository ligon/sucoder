;;; dream_editorial.el --- Inline Org editorial operations -*- lexical-binding: t; -*-
;; A separate interface preserves the original dream_validate.el contracts.
;; All buffers are inline and read-only; permitted edits bind inhibit-read-only.
;; No files, local variables, setup files, hooks, Babel or user settings run.
(require 'cl-lib)
(require 'json)
(require 'org)
(require 'org-element)

(defun sucoder-dream-edit-bytes (position)
  (string-bytes (buffer-substring-no-properties (point-min) position)))

(defun sucoder-dream-edit-hash (begin end)
  (secure-hash 'sha256 (encode-coding-string
                       (buffer-substring-no-properties begin end) 'utf-8-unix)))

(defun sucoder-dream-edit-path (source destination)
  (if (or (string-prefix-p "~" destination) (file-name-absolute-p destination))
      destination
    (file-relative-name
     (expand-file-name destination (file-name-directory (expand-file-name source "/"))) "/")))

(defun sucoder-dream-edit-inspect ()
  (let ((tree (org-element-parse-buffer)) (headings nil) (links nil)
        (targets (make-hash-table :test 'equal)))
    (org-element-map tree 'headline
      (lambda (heading)
        (goto-char (org-element-property :begin heading))
        (let* ((begin (point)) (end (org-element-property :end heading))
               (target (org-element-property :CUSTOM_ID heading))
               (properties (make-hash-table :test 'equal))
               (section (car (org-element-contents heading)))
               (logbook nil)
               (local (org-get-tags nil t))
               (inherited (cl-set-difference (org-get-tags) local :test #'equal))
               (hash (sucoder-dream-edit-hash begin end)))
          (dolist (property (org-entry-properties nil 'standard))
            (puthash (car property) (cdr property) properties))
          (when (eq (org-element-type section) 'section)
            (org-element-map section 'drawer
              (lambda (drawer)
                (when (equal (org-element-property :drawer-name drawer) "LOGBOOK")
                  (setq logbook
                        (buffer-substring-no-properties
                         (org-element-property :begin drawer)
                         (org-element-property :end drawer)))))))
          (when target
            (when (gethash target targets) (error "Duplicate editorial CUSTOM_ID"))
            (puthash target hash targets))
          (push `((target . ,target) (title . ,(org-element-property :raw-value heading))
                  (state . ,(org-element-property :todo-keyword heading))
                  (level . ,(org-element-property :level heading))
                  (begin . ,(sucoder-dream-edit-bytes begin))
                  (end . ,(sucoder-dream-edit-bytes end))
                  (sha256 . ,hash) (properties . ,properties)
                  (closed . ,(org-entry-get nil "CLOSED"))
                  (logbook . ,logbook) (outline . ,(vconcat (org-get-outline-path)))
                  (local_tags . ,(vconcat local)) (inherited_tags . ,(vconcat inherited))) headings))))
    (org-element-map tree 'link
      (lambda (link)
        (let ((type (org-element-property :type link))
              (path (org-element-property :path link)))
          (push `((type . ,type) (raw_path . ,path)
                  (path . ,(if (equal type "file")
                               (sucoder-dream-edit-path (buffer-name) path) path))
                  (search . ,(org-element-property :search-option link))
                  (begin . ,(sucoder-dream-edit-bytes (org-element-property :begin link)))
                  (end . ,(sucoder-dream-edit-bytes (org-element-property :end link)))) links))))
    `((targets . ,targets) (headings . ,(vconcat (nreverse headings)))
      (links . ,(vconcat (nreverse links))))))

(defun sucoder-dream-edit-target (target)
  (let ((position (org-find-property "CUSTOM_ID" target)))
    (unless position (error "Editorial target is unavailable"))
    (goto-char position)
    (org-back-to-heading t)))

(defun sucoder-dream-edit-heading ()
  (let ((position (point)))
    (org-element-map (org-element-parse-buffer) 'headline
      (lambda (heading)
        (and (= position (org-element-property :begin heading)) heading)) nil t)))

(defun sucoder-dream-edit-links (source destination moves)
  "Preserve link destinations when relocating text; repair known incoming links."
  (let ((replacements nil))
    (org-element-map (org-element-parse-buffer) 'link
      (lambda (link)
        (let* ((type (org-element-property :type link))
               (path (org-element-property :path link))
               (search (org-element-property :search-option link))
               (file (cond ((equal type "custom-id") source)
                           ((equal type "file") (sucoder-dream-edit-path source path))))
               (target (if (equal type "custom-id") path
                         (and search (string-prefix-p "#" search) (substring search 1))))
               (moved (and file target (cdr (assoc (cons file target) moves))))
               (resolved (or moved file)))
          (when (and resolved (not (or (string-prefix-p "~" resolved)
                                      (file-name-absolute-p resolved))))
            (let* ((relative (file-relative-name (expand-file-name resolved "/")
                                                (file-name-directory (expand-file-name destination "/"))))
                   (suffix (if target (concat "::#" target) (if search (concat "::" search) "")))
                   (uri (if (and (equal type "custom-id") (equal resolved destination))
                            (concat "#" target)
                          (concat "file:" (org-link-escape relative) suffix)))
                   (begin (org-element-property :begin link))
                   (end (- (org-element-property :end link) (or (org-element-property :post-blank link) 0)))
                   (cb (org-element-property :contents-begin link))
                   (ce (org-element-property :contents-end link))
                   (description (and cb ce (buffer-substring-no-properties cb ce)))
                   (text (org-link-make-string uri description)))
              (when (or moved (not (equal source destination)))
                (push (list begin end text) replacements)))))))
    (dolist (replacement (sort replacements (lambda (a b) (> (car a) (car b)))))
      (goto-char (nth 0 replacement))
      (delete-region (nth 0 replacement) (nth 1 replacement))
      (insert (nth 2 replacement)))))

(defun sucoder-dream-edit-transition (action stamp)
  (let* ((before (org-get-todo-state)) (state (alist-get 'state action))
         (note (alist-get 'note action))
         (property-notes nil)
         (org-inhibit-logging t) (org-log-done nil) (org-todo-log-states nil)
         (org-after-todo-state-change-hook nil) (org-trigger-hook nil))
    (unless (and before (member state '("TODO" "NEXT" "ACTIVE" "WAITING" "REVIEW" "DONE" "MOOT")))
      (error "Transition needs an existing task and an approved state"))
    (when (equal before state) (error "A state transition must change state"))
    (org-todo state)
    (dolist (property (alist-get 'properties action))
      (let* ((key (symbol-name (car property))) (old (org-entry-get nil key)))
        (unless (equal old (cdr property))
          (push (concat key ": " (or old "none") " -> " (cdr property)) property-notes)))
      (org-entry-put nil (symbol-name (car property)) (cdr property)))
    (dolist (property (alist-get 'clear_properties action))
      (let ((old (org-entry-get nil property)))
        (when old
          (push (concat property ": " old " -> cleared") property-notes)
          (org-entry-delete nil property))))
    (if (member state '("DONE" "MOOT"))
        (org-add-planning-info 'closed (date-to-time stamp))
      (org-add-planning-info nil nil 'closed))
    (org-back-to-heading t)
    (let* ((section (car (org-element-contents (sucoder-dream-edit-heading))))
           (drawer (and (eq (org-element-type section) 'section)
                        (car (org-element-map section 'drawer
                               (lambda (element)
                                 (and (equal (org-element-property :drawer-name element) "LOGBOOK") element))))))
           (entry (concat "- State \"" state "\" from \"" before "\" "
                          (format-time-string "[%Y-%m-%d %a %H:%M]" (date-to-time stamp) t)
                          " \\\\\n  " note
                          (if property-notes (concat " Properties: " (mapconcat #'identity (nreverse property-notes) "; ") ".") "")
                          "\n")))
      (if drawer
          (progn (goto-char (org-element-property :begin drawer)) (forward-line 1) (insert entry))
        (org-end-of-meta-data t)
        (insert ":LOGBOOK:\n" entry ":END:\n")))))

(defun sucoder-dream-edit-archive (action stamp buffers)
  (let* ((source (alist-get 'path action)) (destination (alist-get 'destination action))
         (heading (sucoder-dream-edit-heading))
         (begin (org-element-property :begin heading)) (end (org-element-property :end heading))
         (level (org-element-property :level heading))
         (outline (org-get-outline-path))
         (inherited (cl-remove-if-not (lambda (tag) (get-text-property 0 'inherited tag)) (org-get-tags)))
         (state (org-get-todo-state)) (category (org-get-category))
         (members nil) (mapping nil) (forwarder "")
         (subtree (buffer-substring-no-properties begin end)))
    (unless (member state '("DONE" "MOOT")) (error "Only terminal tasks may be archived"))
    (org-element-map heading 'headline
      (lambda (child)
        (let ((todo (org-element-property :todo-keyword child))
              (id (org-element-property :CUSTOM_ID child)))
          (when (and todo (not (member todo '("DONE" "MOOT"))))
            (error "Archive has an open descendant task"))
          (when (org-element-property :ID child)
            (unless id (error "Archived IDs require a CUSTOM_ID forwarding target")))
          (when id
            (push (cons (cons source id) destination) mapping)
            (push `((target . ,id) (title . ,(org-element-property :raw-value child))
                    (level . ,(org-element-property :level child))) members)))))
    (setq members (nreverse members))
    (dolist (member members)
      (setq forwarder (concat forwarder (make-string (alist-get 'level member) ?*) " "
                              "Archived: " (alist-get 'title member) "\n:PROPERTIES:\n:CUSTOM_ID: "
                              (alist-get 'target member) "\n:END:\n"
                              (org-link-make-string
                               (concat "file:" (org-link-escape
                                                (file-relative-name (expand-file-name destination "/")
                                                                    (file-name-directory (expand-file-name source "/"))))
                                       "::#" (alist-get 'target member)) "Archived editorial decision") "\n\n")))
    (delete-region begin end)
    (goto-char begin)
    (insert forwarder)
    (let ((target-buffer (gethash destination buffers)))
      (unless target-buffer (error "Archive destination was not supplied"))
      (with-temp-buffer
        (insert subtree)
        (setq buffer-read-only t)
        (org-mode)
        (let ((inhibit-read-only t))
          (sucoder-dream-edit-links source destination mapping)
          (setq subtree (buffer-string))))
      (with-current-buffer target-buffer
        (goto-char (point-max))
        (unless (bolp) (insert "\n"))
        (insert "\n")
        (org-paste-subtree 1 subtree)
        (sucoder-dream-edit-target (alist-get 'target action))
        (org-entry-put nil "ARCHIVE_FILE" source)
        (org-entry-put nil "ARCHIVE_OLPATH" (mapconcat #'identity outline "/"))
        (org-entry-put nil "ARCHIVE_ITAGS" (mapconcat #'identity inherited " "))
        (org-entry-put nil "ARCHIVE_TODO" state)
        (org-entry-put nil "ARCHIVE_CATEGORY" category)
        (org-entry-put nil "ARCHIVE_TIME" (format-time-string "%Y-%m-%d %a %H:%M" (date-to-time stamp) t))))
    `((source . ,source) (destination . ,destination) (target . ,(alist-get 'target action))
      (targets . ,(vconcat (mapcar (lambda (member) (alist-get 'target member)) members)))
      (mapping . ,mapping))))

(condition-case failure
 (let* ((json-array-type 'list) (json-object-type 'alist) (json-key-type 'symbol)
       (request (json-read-from-string (with-temp-buffer (insert-file-contents "/dev/stdin") (buffer-string))))
       (buffers (make-hash-table :test 'equal)) (original (make-hash-table :test 'equal))
       (inventory (make-hash-table :test 'equal)) (files (make-hash-table :test 'equal))
       (baseline (make-hash-table :test 'equal)) (moves nil) (mapping nil)
       (org-mode-hook nil) (org-inhibit-startup t) (org-use-tag-inheritance t)
       (org-todo-keywords '((sequence "TODO" "NEXT" "ACTIVE" "WAITING" "REVIEW" "|" "DONE" "MOOT")))
       (org-insert-heading-hook nil) (org-after-tags-change-hook nil)
       (org-property-changed-functions nil) (org-todo-state-tags-triggers nil)
       (file-name-handler-alist nil) (system-time-locale "C"))
  (unwind-protect
      (progn
        (dolist (file (alist-get 'files request))
          (let* ((path (symbol-name (car file))) (buffer (generate-new-buffer path)))
            (puthash path buffer buffers)
            (puthash path (cdr file) original)
            (with-current-buffer buffer
              (insert (cdr file))
              (setq buffer-read-only t)
              (org-mode)
              (unless (org-collect-keywords '("CATEGORY"))
                (setq-local org-category (file-name-base path)))
              (let ((details (sucoder-dream-edit-inspect)))
                (dolist (heading (append (alist-get 'headings details) nil))
                  (when (alist-get 'target heading)
                    (puthash (cons path (alist-get 'target heading)) (alist-get 'sha256 heading) baseline)))))))
        (let ((inhibit-read-only t))
          (dolist (action (alist-get 'actions request))
            (let* ((path (alist-get 'path action)) (target (alist-get 'target action))
                   (buffer (gethash path buffers)))
              (unless (and buffer (equal (gethash (cons path target) baseline) (alist-get 'before_sha256 action)))
                (error "Editorial action differs from its frozen subtree"))
              (with-current-buffer buffer
                (sucoder-dream-edit-target target)
                (pcase (alist-get 'kind action)
                  ("transition" (sucoder-dream-edit-transition action (alist-get 'timestamp request)))
                  ("archive" (let ((move (sucoder-dream-edit-archive action (alist-get 'timestamp request) buffers)))
                               (setq mapping (append (alist-get 'mapping move) mapping))
                               (push (assq-delete-all 'mapping move) moves)))
                  (_ (error "Unsupported editorial action"))))))
          (maphash (lambda (path buffer)
                     (with-current-buffer buffer
                       (sucoder-dream-edit-links path path mapping))) buffers))
        (maphash (lambda (path buffer)
                   (with-current-buffer buffer
                     (puthash path (sucoder-dream-edit-inspect) inventory)
                     (unless (equal (gethash path original) (buffer-string))
                       (puthash path (buffer-string) files)))) buffers)
        (princ (json-encode `((contract . "native-editorial-org-v1")
                              (inventory . ,inventory) (files . ,files) (moves . ,(vconcat (nreverse moves)))))))
    (maphash (lambda (_ buffer) (kill-buffer buffer)) buffers)))
 (error (princ (json-encode `((error . ,(error-message-string failure))))) (kill-emacs 2)))
